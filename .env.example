# Copy to .env.local and fill in.
# The app validates these at startup and crashes immediately if required vars are missing.
# NEVER commit .env.local to git.

NODE_ENV=development

# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# NextAuth — generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-secret-min-16-chars"
NEXTAUTH_URL="http://localhost:3000"

LOG_LEVEL=info

# Public vars — safe to expose to the browser (prefix NEXT_PUBLIC_)
NEXT_PUBLIC_APP_NAME="App"
