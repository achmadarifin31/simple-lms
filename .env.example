# Copy to .env.local and fill in.
# The app validates these at startup and crashes immediately if required vars are missing.
# NEVER commit .env.local to git.

NODE_ENV=development

# Postgres connection string (Supabase).
# Local/dev: gunakan Session pooler (port 5432) untuk keduanya.
# Vercel/serverless: DATABASE_URL = Transaction pooler (6543, ?pgbouncer=true),
#                    DIRECT_URL   = Session pooler (5432) untuk migrasi.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# NextAuth — generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-secret-min-16-chars"
AUTH_SECRET="change-me-to-a-long-random-secret-min-16-chars"
NEXTAUTH_URL="http://localhost:3000"
# Produksi (Vercel): set true agar NextAuth memercayai host.
# AUTH_TRUST_HOST=true

LOG_LEVEL=info

# Public vars — safe to expose to the browser (prefix NEXT_PUBLIC_)
NEXT_PUBLIC_APP_NAME="App"
